---
// Monthly temperature + rain, and the annual wind rose, drawn as plain SVG from the project's climate.json.
interface Month { month: number; temp_mean: number; temp_max: number; temp_min: number; rh_mean: number; rain_mm: number; wind_mean: number; calm_pct: number }
interface Props { data: { station_note: string; monthly: Month[]; wind_rose: { sectors_from_north_deg: number[]; pct_of_hours: number[]; calm_pct: number } } }
const { data } = Astro.props;
const M = data.monthly;
const names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// temperature panel
const W = 720, H = 260, L = 58, R = 12, T = 22, B = 28;
const tLo = 15, tHi = 40;
const x = (i: number) => L + ((i + 0.5) / 12) * (W - L - R);
const y = (t: number) => T + (1 - (t - tLo) / (tHi - tLo)) * (H - T - B);
const band = "M" + M.map((m, i) => `${x(i)},${y(m.temp_max)}`).join("L") + "L" + [...M].reverse().map((m, j) => `${x(11 - j)},${y(m.temp_min)}`).join("L") + "Z";
const mean = "M" + M.map((m, i) => `${x(i)},${y(m.temp_mean)}`).join("L");
const hottest = M.reduce((a, b) => (b.temp_max > a.temp_max ? b : a));

// rain panel
const RH = 150, rMax = Math.max(...M.map((m) => m.rain_mm));
const bw = ((W - L - R) / 12) * 0.56;
const rainY = (v: number) => 30 + (1 - v / rMax) * (RH - 30 - 26);
const wettest = [...M].sort((a, b) => b.rain_mm - a.rain_mm).slice(0, 2).map((m) => m.month);
const rainTotal = M.reduce((s, m) => s + m.rain_mm, 0);

// wind rose
const wr = data.wind_rose, Rr = 130, inner = 22;
const pMax = Math.ceil(Math.max(...wr.pct_of_hours) / 2) * 2;
const rr = (p: number) => inner + (p / pMax) * (Rr - inner);
const wedge = (az: number, p: number) => {
  const a0 = ((az - 9) * Math.PI) / 180, a1 = ((az + 9) * Math.PI) / 180, r = rr(p);
  const P = (a: number, rad: number) => `${(rad * Math.sin(a)).toFixed(1)},${(-rad * Math.cos(a)).toFixed(1)}`;
  return `M${P(a0, inner)}L${P(a0, r)}A${r},${r} 0 0 1 ${P(a1, r)}L${P(a1, inner)}A${inner},${inner} 0 0 0 ${P(a0, inner)}Z`;
};
const dirs = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"];
const top = wr.pct_of_hours.map((p, i) => [p, i] as const).sort((a, b) => b[0] - a[0]).slice(0, 2).map(([, i]) => dirs[i]);
const calmApr = M[3].calm_pct;
---
<style is:inline>@media (max-width: 640px) { .chart text { font-size: 22px; } }</style>
<div class="grid gap-x-16 gap-y-16 lg:grid-cols-12">
  <figure class="relative lg:col-span-7">
    <h3 class="font-display text-2xl font-normal">Temperature and rain, month by month</h3>
    <svg viewBox={`0 0 ${W} ${H}`} class="chart mt-6 w-full" role="img" aria-label={`Mean daily temperature range by month, from ${M[0].temp_min} to ${hottest.temp_max} °C; hottest in ${names[hottest.month - 1]}.`}>
      {[20, 30, 40].map((t) => (<>
        <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} stroke="var(--color-ink)" stroke-width=".5" stroke-opacity=".35" />
        <text x={L - 8} y={y(t) + 4} text-anchor="end" font-size="12" fill="var(--color-olive)" font-family="var(--font-sans)">{t}°</text>
      </>))}
      <path class="fade" d={band} fill="var(--color-dust)" fill-opacity=".65" />
      <path class="draw" pathLength="1" d={mean} fill="none" stroke="var(--color-ink)" stroke-width="2" />
      {M.map((m, i) => <circle class="fade" cx={x(i)} cy={y(m.temp_mean)} r="2.5" fill="var(--color-ink)" />)}
      <text x={x(hottest.month - 1)} y={y(hottest.temp_max) - 6} text-anchor="middle" font-size="12" fill="var(--color-ink)" font-family="var(--font-sans)">{hottest.temp_max}°</text>
      {names.map((n, i) => <text x={x(i)} y={H - 8} text-anchor="middle" font-size="12" fill="var(--color-ink)" font-family="var(--font-sans)">{n[0]}</text>)}
    </svg>
    <svg viewBox={`0 0 ${W} ${RH}`} class="chart mt-4 w-full" role="img" aria-label={`Rain by month, ${rainTotal} mm a year, most in ${wettest.map((m) => names[m - 1]).join(" and ")}.`}>
      {M.map((m, i) => (<>
        <rect class="grow" style={`--i:${i}`} x={x(i) - bw / 2} y={rainY(m.rain_mm)} width={bw} height={RH - 26 - rainY(m.rain_mm)} fill={wettest.includes(m.month) ? "var(--color-brick)" : "var(--color-water)"} />
        {wettest.includes(m.month) && <text x={x(i)} y={rainY(m.rain_mm) - 5} text-anchor="middle" font-size="12" fill="var(--color-ink)" font-family="var(--font-sans)">{m.rain_mm}</text>}
      </>))}
      <line x1={L} x2={W - R} y1={RH - 26} y2={RH - 26} stroke="var(--color-ink)" stroke-width="1" />
      {names.map((n, i) => <text x={x(i)} y={RH - 8} text-anchor="middle" font-size="12" fill="var(--color-ink)" font-family="var(--font-sans)">{n[0]}</text>)}
    </svg>
    <figcaption class="mt-3 text-sm text-olive">Band: mean daily low to high. Line: monthly mean. Bars: rain in mm.</figcaption>
    <details class="mt-4 text-sm"><summary class="cursor-pointer underline underline-offset-4">See the numbers</summary><table class="mt-3 w-full text-left [&_td]:py-1 [&_th]:py-1 [&_th]:font-medium">
      <caption class="sr-only">Monthly climate, {data.station_note}</caption>
      <thead><tr><th>Month</th><th>Mean °C</th><th>Low °C</th><th>High °C</th><th>Humidity %</th><th>Rain mm</th><th>Calm %</th></tr></thead>
      <tbody>{M.map((m) => <tr><td>{names[m.month - 1]}</td><td>{m.temp_mean}</td><td>{m.temp_min}</td><td>{m.temp_max}</td><td>{m.rh_mean}</td><td>{m.rain_mm}</td><td>{m.calm_pct}</td></tr>)}</tbody>
    </table></details>
  </figure>

  <figure class="relative lg:col-span-5">
    <h3 class="font-display text-2xl font-normal">Where the wind comes from</h3>
    <svg viewBox={`${-Rr - 24} ${-Rr - 24} ${2 * Rr + 48} ${2 * Rr + 48}`} class="mt-6 w-full max-w-[420px]" role="img" aria-label={`Wind rose: most often from the ${top.join(" and ")}. Completely calm ${wr.calm_pct}% of hours.`}>
      {[pMax / 2, pMax].map((p) => <circle r={rr(p)} fill="none" stroke="var(--color-ink)" stroke-width=".6" stroke-opacity=".5" />)}
      {wr.pct_of_hours.map((p, i) => <path class="petal" style={`--i:${i}`} d={wedge(wr.sectors_from_north_deg[i], p)} fill="var(--color-laterite)" fill-opacity=".85" />)}
      <circle r={inner} fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="1" />
      <text y="-2" text-anchor="middle" font-size="12" fill="var(--color-ink)" font-family="var(--font-sans)">calm</text>
      <text y="12" text-anchor="middle" font-size="12" fill="var(--color-ink)" font-family="var(--font-sans)">{Math.round(wr.calm_pct)}%</text>
      {[["N", 0, -1], ["E", 1, 0], ["S", 0, 1], ["W", -1, 0]].map(([t, cx, cy]) => <text x={(cx as number) * (Rr + 14)} y={(cy as number) * (Rr + 14) + 4} text-anchor="middle" font-size="12" fill="var(--color-ink)" font-family="var(--font-sans)">{t}</text>)}
      <text x="4" y={-rr(pMax) - 4} font-size="10" fill="var(--color-olive)" font-family="var(--font-sans)">{pMax}% of hours</text>
    </svg>
    <figcaption class="mt-3 text-[17px]">Most often from the {top.join(" and ")}, but rarely with any force. Still air {Math.round(wr.calm_pct)}% of the year, {calmApr}% in April.</figcaption>
    <details class="mt-4 text-sm"><summary class="cursor-pointer underline underline-offset-4">See the numbers</summary><table class="mt-3 w-full max-w-[240px] text-left [&_td]:py-1 [&_th]:py-1 [&_th]:font-medium">
      <caption class="sr-only">Share of hours by wind direction</caption>
      <tbody>{wr.pct_of_hours.map((p, i) => <tr><th>{dirs[i]}</th><td>{p}%</td></tr>)}</tbody>
    </table></details>
  </figure>
</div>
<p class="mt-10 text-sm text-olive">Source: {data.station_note}.</p>
