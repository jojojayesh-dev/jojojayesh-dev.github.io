---
// Before/after: the "before" image sits on top, clipped to the slider position. Works as a 50/50 split without JS.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Side { src: ImageMetadata; alt: string; label: string }
interface Props { before: Side; after: Side; name: string }
const { before, after, name } = Astro.props;
---
<figure class="compare relative select-none has-[input:focus-visible]:outline-2 has-[input:focus-visible]:outline-offset-4 has-[input:focus-visible]:outline-brick" style="--pos: 50%">
  <Image src={after.src} alt={after.alt} widths={[640, 1024, 1400]} sizes="(min-width: 1440px) 1312px, 100vw" class="block w-full" />
  <div class="absolute inset-0" style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)">
    <Image src={before.src} alt={before.alt} widths={[640, 1024, 1400]} sizes="(min-width: 1440px) 1312px, 100vw" class="block h-full w-full object-cover" />
  </div>
  <div class="pointer-events-none absolute inset-y-0 w-0.5 bg-paper" style="left: var(--pos)" aria-hidden="true"></div>
  <span class="absolute top-3 left-3 bg-paper px-2.5 py-1 text-[17px]" aria-hidden="true">{before.label}</span>
  <span class="absolute top-3 right-3 bg-paper px-2.5 py-1 text-[17px]" aria-hidden="true">{after.label}</span>
  <input type="range" min="0" max="100" value="50" aria-label={`${name}: slide between ${before.label} and ${after.label}`} class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>(".compare")) {
    const input = fig.querySelector("input")!;
    input.addEventListener("input", () => fig.style.setProperty("--pos", `${input.value}%`));
  }
</script>
