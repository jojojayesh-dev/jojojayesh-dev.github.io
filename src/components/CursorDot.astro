---
// Orange-red dot that follows the mouse. The system cursor is hidden only once the dot is actually running,
// and only for a fine pointer without reduced motion, so nobody is ever left with no cursor at all.
---
<div data-cursor aria-hidden="true" class="pointer-events-none fixed top-0 left-0 z-50 size-3 rounded-full bg-accent opacity-0 transition-[opacity,width,height] duration-200"></div>

<script>
  const dot = document.querySelector<HTMLElement>("[data-cursor]")!;
  const ok = matchMedia("(pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (ok) {
    let x = -100, y = -100, cx = -100, cy = -100, raf = 0;
    const loop = () => {
      cx += (x - cx) * 0.22; cy += (y - cy) * 0.22;
      dot.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%)`;
      raf = Math.abs(x - cx) + Math.abs(y - cy) > 0.1 ? requestAnimationFrame(loop) : 0;
    };
    addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      x = e.clientX; y = e.clientY;
      if (!document.documentElement.classList.contains("custom-cursor")) { cx = x; cy = y; document.documentElement.classList.add("custom-cursor"); dot.style.opacity = "1"; }
      const over = (e.target as Element).closest("a, button, summary, label, input, [role=button]");
      dot.classList.toggle("size-3", !over); dot.classList.toggle("size-5", !!over);
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });
    document.addEventListener("pointerleave", () => (dot.style.opacity = "0"));
    document.addEventListener("pointerenter", () => document.documentElement.classList.contains("custom-cursor") && (dot.style.opacity = "1"));
  }
</script>
