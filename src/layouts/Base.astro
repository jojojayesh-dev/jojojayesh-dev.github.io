---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LiveCorner from "../components/LiveCorner.astro";
import DrawingGrid from "../components/DrawingGrid.astro";
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
interface Props { title: string; description: string; image?: ImageMetadata; imageAlt?: string; place?: { label: string; coords: string } }
const { title, description } = Astro.props;
// link preview: the page's own picture, else the lead project's cover, cropped to 1200x630
const lead = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order)[0]?.data;
const src = Astro.props.image ?? lead?.cover;
const og = src && (await getImage({ src, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 82 }));
const ogUrl = og && new URL(og.src, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Jayesh Banerjee" />
    <link rel="canonical" href={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    {ogUrl && <meta property="og:image:alt" content={Astro.props.imageAlt ?? lead?.cover_alt ?? title} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F4EEE2" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-3">Skip to content</a>
    <DrawingGrid />
    <Header />
    <slot />
    <Footer />
    <LiveCorner {...Astro.props.place} />
    <script>import "../scripts/motion";</script>
  </body>
</html>
