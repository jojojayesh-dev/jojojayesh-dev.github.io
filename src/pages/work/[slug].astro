---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({ params: { slug: p.data.slug }, props: { p, next: all[(i + 1) % all.length] } }));
}
const { p, next } = Astro.props;
const d = p.data;
const text = Object.fromEntries((d.text?.sections ?? []).map((s) => [s.heading, s.paragraphs]));
const [concept, climateText, ground, status] = (d.text?.sections ?? []).map((s) => s.heading);
const gallery = d.sections.find((s) => s.type === "gallery")?.items ?? [];
const pick = (zone: string) => gallery.filter((g) => g.zone === zone);
const c = d.climate ?? {};
// key_numbers.txt values are shown as written; only the unit "C" is typeset as °C
const deg = (v = "") => v.replace(/ C$/, " °C");
const [tmax, tmin] = (c["Max / min dry bulb"] ?? "").replace(" C", "").split(" / ");
const figures = [
  [deg(c["Annual mean dry bulb"]), "mean temperature", `range ${tmin}–${tmax} °C`],
  [c["Mean relative humidity"], "mean humidity", "warm-humid all year"],
  [c["Mean wind speed"], "mean wind", "the number that changed the design"],
  [c["Annual precipitation in EPW"], "rain a year", "arriving with the north-east monsoon"],
];
const facts = [
  ["Site", "Auroville, Tamil Nadu"],
  ["Plot", `${d.site.area_sqm} m², 0.9 m level step`],
  ["Brief", "Anganwadi for 30 children, 2–5 yrs"],
  ["Year", String(d.year)],
  ["Role", d.role],
];
const zones = ["Ground", "Skin", "Air", "Water", "Play + Community"];
---
<Base title={`${d.title} · Jayesh Banerjee`} description={d.text?.lede ?? d.subtitle}>
  <main id="main">
    <section class="gutter mx-auto grid max-w-[1440px] gap-x-16 gap-y-10 pt-6 lg:grid-cols-12">
      <div class="flex flex-col justify-between gap-10 lg:col-span-5">
        <div>
          <h1 class="font-serif text-[clamp(52px,7.4vw,124px)] leading-[.9] font-light tracking-[-.035em]">{d.title}</h1>
          <p class="mt-8 max-w-[30ch] font-serif text-2xl leading-snug font-light">{d.text?.lede ?? d.subtitle}</p>
        </div>
        <dl class="grid grid-cols-2 gap-x-8 gap-y-4 border-t border-ink pt-5 text-[17px] sm:grid-cols-3">
          {facts.map(([k, v]) => <div><dt class="text-olive">{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
      <figure class="lg:col-span-7">
        <Image src={d.cover} alt="A brick moon gate I photographed in Auroville, framing the courtyard beyond it." widths={[640, 960, 1440, 1920]} sizes="(min-width: 1024px) 58vw, 100vw" class="aspect-[4/3] w-full object-cover" loading="eager" fetchpriority="high" />
        <figcaption class="mt-2 text-sm text-olive">Moon gate, Auroville, June 2026. Cover until the AYDA renders are done.</figcaption>
      </figure>
    </section>

    {concept && (
      <section class="gutter mx-auto mt-40 grid max-w-[1440px] gap-x-16 gap-y-10 lg:grid-cols-12" aria-labelledby="concept">
        <div class="lg:col-span-5">
          <h2 id="concept" class="font-serif text-[clamp(40px,4.6vw,72px)] leading-none font-light tracking-[-.02em]">{concept}</h2>
          <div class="mt-8 space-y-5 text-[17px]">{text[concept].map((t) => <p class="max-w-[56ch]">{t}</p>)}</div>
        </div>
        {pick("Absence")[0] && (
          <figure class="lg:col-span-6 lg:col-start-7">
            <Image src={pick("Absence")[0].src} alt={pick("Absence")[0].alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/5] w-full object-cover" />
            <figcaption class="mt-2 text-sm text-olive">{pick("Absence")[0].place}, June 2026</figcaption>
          </figure>
        )}
      </section>
    )}

    {climateText && (
      <section class="mt-40 bg-kraft py-24" aria-labelledby="climate">
        <div class="gutter mx-auto grid max-w-[1440px] gap-x-16 gap-y-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <h2 id="climate" class="font-serif text-[clamp(40px,4.6vw,72px)] leading-none font-light tracking-[-.02em]">{climateText}</h2>
            <div class="mt-8 space-y-5 text-[17px]">{text[climateText].map((t) => <p class="max-w-[56ch]">{t}</p>)}</div>
          </div>
          <div class="lg:col-span-7">
            <dl class="grid grid-cols-2 gap-x-8 gap-y-10">
              {figures.map(([v, k, note]) => (
                <div class="border-t border-ink pt-4">
                  <dt class="sr-only">{k}</dt>
                  <dd class="font-serif text-[clamp(40px,4.6vw,72px)] leading-none font-light tracking-[-.03em]">{v}</dd>
                  <dd class="mt-3 text-[17px]">{k}<span class="text-olive">, {note}</span></dd>
                </div>
              ))}
            </dl>
            <p class="mt-10 text-sm text-olive">Source: {c["Note"]}.</p>
          </div>
        </div>
      </section>
    )}

    {ground && (
      <section class="gutter mx-auto mt-40 max-w-[1440px]" aria-labelledby="ground">
        <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12">
          <h2 id="ground" class="font-serif text-[clamp(40px,4.6vw,72px)] leading-none font-light tracking-[-.02em] lg:col-span-5">{ground}</h2>
          <div class="space-y-5 text-[17px] lg:col-span-6 lg:col-start-7">{text[ground].map((t) => <p class="max-w-[56ch]">{t}</p>)}</div>
        </div>
        {zones.map((z) => pick(z).length > 0 && (
          <div class="mt-20 grid gap-x-16 gap-y-6 border-t border-ink pt-6 lg:grid-cols-12">
            <h3 class="font-serif text-2xl leading-none font-light lg:col-span-3">{z}</h3>
            <div class="grid gap-4 lg:col-span-9" style={`grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr))`}>
              {pick(z).map((g) => (
                <figure>
                  <Image src={g.src} alt={g.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 30vw, 100vw" class:list={["w-full object-cover", pick(z).length === 1 ? "aspect-[16/9] object-[50%_78%]" : "aspect-[4/5]"]} />
                  <figcaption class="mt-2 text-sm"><span aria-hidden="true">{g.alt}</span> <span class="text-olive">{g.place}.</span></figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))}
      </section>
    )}

    {status && (
      <section class="gutter mx-auto mt-40 grid max-w-[1440px] gap-x-16 gap-y-8 lg:grid-cols-12" aria-labelledby="status">
        <h2 id="status" class="font-serif text-[clamp(40px,4.6vw,72px)] leading-none font-light tracking-[-.02em] lg:col-span-5">{status}</h2>
        <div class="space-y-6 text-[17px] lg:col-span-6 lg:col-start-7">
          {text[status].map((t) => <p class="max-w-[56ch]">{t}</p>)}
          {d.dashboard && <p><a href={d.dashboard}>Open my full site analysis dashboard</a></p>}
        </div>
      </section>
    )}

    <nav class="gutter mx-auto mt-40 flex max-w-[1440px] flex-wrap justify-between gap-6 border-t border-ink pt-5 text-[17px]" aria-label="Projects">
      <a href="/">Back to all work</a>
      {next.data.slug !== d.slug && <a href={`/work/${next.data.slug}/`}>Next: {next.data.title}</a>}
    </nav>
  </main>
</Base>
