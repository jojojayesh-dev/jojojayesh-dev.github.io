---
// Case study page. Sections render in the order the project's portfolio.yaml lists them.
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ClimateCharts from "../../components/ClimateCharts.astro";
import SunStudy from "../../components/SunStudy.astro";
import CompareSlider from "../../components/CompareSlider.astro";
import Masonry from "../../components/Masonry.astro";
import CoverExpand from "../../components/motion/CoverExpand";
import Counter from "../../components/rb/Counter";

export async function getStaticPaths() {
  const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({ params: { slug: p.data.slug }, props: { p, next: all[(i + 1) % all.length] } }));
}
const { p, next } = Astro.props;
const d = p.data;
const text = Object.fromEntries((d.text?.sections ?? []).map((s) => [s.heading, s.paragraphs]));
const c = d.climate ?? {};
// key_numbers.txt values are shown as written; only the unit "C" is typeset as °C
const deg = (v = "") => v.replace(/ C$/, " °C");
const [tmax, tmin] = (c["Max / min dry bulb"] ?? "").replace(" C", "").split(" / ");
const figures = [
  [deg(c["Annual mean dry bulb"]), "mean temperature", `range ${tmin}–${tmax} °C`],
  [c["Mean relative humidity"], "mean humidity", "warm-humid all year"],
  [c["Mean wind speed"], "mean wind", d.climateData ? `still air ${Math.round(d.climateData.wind_rose.calm_pct)}% of hours` : "light all year"],
  [c["Annual precipitation in EPW"], "rain a year", "arriving with the north-east monsoon"],
];
const facts = [
  ["Site", "Auroville, Tamil Nadu"],
  ["Plot", `${d.site.area_sqm} m², 0.9 m level step`],
  ["For", "30 children, 2–5 yrs, and their mothers"],
  ["Year", String(d.year)],
  ["Role", d.role],
];
const H2 = "font-display text-[clamp(40px,5.8vw,100px)] leading-[.92] font-normal tracking-[-.04em]";
// keep numbers and units on one line: 0.9 m/s, 1,165 mm, 28.4 °C, 700 m²
const nb = (t = "") => t.replace(/(\d) (°C|mm|m\/s|m²|m|km|%)(?![\w])/g, "$1\u00a0$2");
const slug = (s = "") => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const ratio = (i: { src: { width: number; height: number } }) => i.src.width / i.src.height;
// URLs for the motion islands (they take plain strings, not image metadata)
const coverWide = (await getImage({ src: d.cover, width: 2000, format: "webp" })).src;
// "4.2 m/s" -> 4.2, " m/s", 1 decimal; values come straight from key_numbers.txt
const num = (v = "") => { const m = v.match(/^([\d.]+)\s*(.*)$/); return m ? { n: +m[1], unit: m[2], dp: (m[1].split(".")[1] ?? "").length } : null; };
// "On this page": every section with a heading, in page order
const toc = d.sections.flatMap((s) =>
  s.type === "sunpath" ? (d.sitePlan ? [{ id: "sun", label: "The sun over my plot" }] : []) : s.type !== "hero" && s.heading ? [{ id: slug(s.heading), label: s.heading }] : []);
---
<Base title={`${d.title} · Jayesh Banerjee`} description={d.text?.lede ?? d.subtitle} image={d.cover} imageAlt={d.cover_alt}
  place={{ label: "Site, Auroville", coords: `${d.site.latitude.toFixed(3)}°N ${d.site.longitude.toFixed(3)}°E` }}>
  <div class="lg:grid lg:grid-cols-[200px_minmax(0,1fr)] xl:grid-cols-[230px_minmax(0,1fr)]">
  <aside class="hidden lg:block">
    <nav aria-label="Sections of this case study" class="toc sticky top-0 max-h-svh overflow-y-auto py-10 pr-4 pl-[clamp(16px,2.2vw,32px)]">
      <a href="#main" class="font-display text-2xl leading-tight font-normal text-ink no-underline">{d.title}</a>
      <ol class="mt-6 border-l border-ink/25">
        {toc.map((t) => <li><a href={`#${t.id}`} class="-ml-px block border-l-2 border-transparent py-1.5 pl-3 text-sm text-olive no-underline hover:text-ink aria-[current=true]:border-brick aria-[current=true]:text-ink">{t.label}</a></li>)}
      </ol>
    </nav>
  </aside>
  <main id="main" class="min-w-0 overflow-x-clip">
    {d.sections.map((s) => {
      const id = slug(s.heading ?? s.type);
      const paras = s.heading ? text[s.heading] ?? [] : [];
      const items = s.items ?? [];

      if (s.type === "hero") return (
        <section class="gutter mx-auto max-w-[1440px] pt-6">
          <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12 lg:items-end">
            <h1 class="font-display text-[clamp(64px,9.5vw,170px)] leading-[.86] font-normal tracking-[-.05em] lg:col-span-12">{d.title}<span class="text-accent">.</span></h1>
            <p class="max-w-[34ch] text-[clamp(18px,1.6vw,24px)] leading-snug lg:col-span-6" data-load="2">{d.text?.lede ?? d.subtitle}</p>
          </div>
          <figure class="mt-10" id="cover-static">
            <div class="overflow-hidden"><Image src={d.cover} alt={d.cover_alt} widths={[640, 1024, 1440, 2000]} sizes="(min-width: 1440px) 1312px, 100vw" class="settle w-full" loading="eager" fetchpriority="high" /></div>
          </figure>
          <CoverExpand client:media="(min-width: 1024px)" src={coverWide} alt={d.cover_alt} fallbackId="cover-static" />
          {d.cover_ai && <p class="mt-2 text-sm text-olive">AI-assisted render.</p>}
          <dl class="mt-6 grid grid-cols-2 gap-x-8 gap-y-4 border-t border-ink pt-5 text-[17px] sm:grid-cols-3 lg:grid-cols-5">
            {facts.map(([k, v]) => <div><dt class="text-olive">{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <details class="mt-8 lg:hidden">
            <summary class="cursor-pointer text-[17px] text-brick">Jump to a section</summary>
            <ol class="mt-3 grid gap-2 text-[17px]">{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
          </details>
        </section>
      );

      if (s.type === "text") return (
        <section class="gutter mx-auto mt-40 grid max-w-[1440px] gap-x-16 gap-y-10 lg:grid-cols-12" aria-labelledby={id}>
          <div class={items.length ? "lg:col-span-5" : "contents"}>
            <h2 id={id} class={`${H2} ${items.length ? "" : "lg:col-span-5"}`}>{s.heading}</h2>
            <div class={items.length ? "mt-8" : "lg:col-span-6 lg:col-start-7"}>
              <div class="space-y-5 text-[17px]">{paras.map((t) => <p class="max-w-[60ch]">{nb(t)}</p>)}</div>
              {s.link === "dashboard" && d.dashboard && <p class="mt-6 text-[17px]"><a href={d.dashboard}>Open my full site analysis dashboard</a></p>}
            </div>
          </div>
          {items.length > 0 && (
            <div class="lg:col-span-7">
              {items.map((i) => (
                <figure>
                  <Image src={i.src} alt={i.alt} widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 55vw, 100vw" class="w-full" />
                  {(i.caption || i.ai) && <figcaption class="mt-2 text-sm text-olive">{i.caption}{i.ai && " AI-assisted render."}</figcaption>}
                </figure>
              ))}
            </div>
          )}
        </section>
      );

      if (s.type === "climate" && s.heading) return (
        <section class="mt-40 bg-kraft py-24" aria-labelledby={id}>
          <div class="gutter mx-auto grid max-w-[1440px] gap-x-16 gap-y-12 lg:grid-cols-12">
            <div class="lg:col-span-6">
              <h2 id={id} class={H2}>{s.heading}</h2>
              <div class="mt-8 space-y-5 text-[17px]">{paras.map((t) => <p class="max-w-[56ch]">{nb(t)}</p>)}</div>
            </div>
            <dl class="grid grid-cols-2 content-start gap-x-8 gap-y-10 lg:col-span-6">
              {figures.map(([v, k, note]) => (
                <div class="border-t border-ink pt-4">
                  <dt class="sr-only">{k}</dt>
                  <dd class="font-display text-[clamp(40px,4.6vw,72px)] leading-none font-normal tracking-[-.03em]">
                    {num(v) ? <Counter client:visible value={num(v)!.n} decimals={num(v)!.dp} suffix={`\u00a0${num(v)!.unit}`} fontSize="1em" bounce={0} motionBlur={false} fade={0} duration={1.2} /> : nb(v)}
                  </dd>
                  <dd class="mt-3 text-[17px]">{k}<span class="text-olive">, {note}</span></dd>
                </div>
              ))}
            </dl>
          </div>
          {d.climateData && <div class="gutter mx-auto mt-24 max-w-[1440px]"><ClimateCharts data={d.climateData} /></div>}
        </section>
      );

      if (s.type === "sunpath" && d.sitePlan) return (
        <section class="gutter mx-auto mt-40 max-w-[1440px]" aria-labelledby="sun">
          <div class="grid gap-x-16 gap-y-6 lg:grid-cols-12">
            <h2 id="sun" class={`${H2} lg:col-span-5`}>The sun over my plot</h2>
            <p class="max-w-[56ch] text-[17px] lg:col-span-6 lg:col-start-7">Between 22 April and 22 August the noon sun is north of overhead, so shadows fall south of the roofs and the north edge needs shade too. Pick a day and an hour to see it.</p>
          </div>
          <div class="mt-14"><SunStudy plan={d.sitePlan} /></div>
        </section>
      );

      if (s.type === "compare" && s.before && s.after) return (
        <section class="gutter mx-auto mt-40 max-w-[1440px]" aria-labelledby={id}>
          <div class="grid gap-x-16 gap-y-6 lg:grid-cols-12">
            <h2 id={id} class={`${H2} lg:col-span-5`}>{s.heading}</h2>
            <div class="space-y-5 text-[17px] lg:col-span-6 lg:col-start-7">{paras.map((t) => <p class="max-w-[60ch]">{nb(t)}</p>)}</div>
          </div>
          <div class="mt-14"><CompareSlider before={s.before} after={s.after} name={s.heading ?? "Compare"} /></div>
          {(s.before.ai || s.after.ai) && <p class="mt-2 text-sm text-olive">AI-assisted renders, 8 am and 2 pm.</p>}
          {items.length > 0 && (
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              {items.map((i) => (
                <figure>
                  <Image src={i.src} alt={i.alt} widths={[480, 760]} sizes="(min-width: 768px) 50vw, 100vw" class="w-full" />
                  {(i.caption || i.ai) && <figcaption class="mt-2 text-sm text-olive">{i.caption}{i.ai && " AI-assisted render."}</figcaption>}
                </figure>
              ))}
            </div>
          )}
        </section>
      );

      if (s.type === "images" && items.length) {
        // Layout follows the pictures: very wide drawings stack, a wide lead picture spans, a squarer lead sits beside the rest
        const wide = items.every((i) => ratio(i) > 2.5);
        const lead = items[0], rest = items.slice(1);
        const fig = (i: typeof lead, sizes: string, cls = "") => (
          <figure class={cls}>
            <Image src={i.src} alt={i.alt} widths={[480, 960, 1600, 2300]} sizes={sizes} class="w-full" />
            {(i.caption || i.ai) && <figcaption class="mt-2 text-sm text-olive">{i.caption}{i.ai && " AI-assisted render."}</figcaption>}
          </figure>
        );
        return (
          <section class="gutter mx-auto mt-40 max-w-[1440px]" aria-labelledby={id}>
            <div class="grid gap-x-16 gap-y-6 lg:grid-cols-12">
              <h2 id={id} class={`${H2} ${paras.length ? "lg:col-span-5" : "lg:col-span-12"}`}>{s.heading}</h2>
              {paras.length > 0 && <div class="space-y-5 text-[17px] lg:col-span-6 lg:col-start-7">{paras.map((t) => <p class="max-w-[60ch]">{nb(t)}</p>)}</div>}
            </div>
            {wide ? (
              <div class="mt-14 space-y-12">{items.map((i) => fig(i, "(min-width: 1440px) 1312px, 100vw"))}</div>
            ) : items.length >= 4 ? (
              <div class="mt-14 grid grid-cols-2 gap-6 lg:grid-cols-4">{items.map((i) => fig(i, "(min-width: 1024px) 25vw, 50vw"))}</div>
            ) : ratio(lead) > 1.6 ? (
              <div class="mt-14 grid gap-6 md:grid-cols-2">
                {fig(lead, "(min-width: 1440px) 1312px, 100vw", "md:col-span-2")}
                {rest.map((i) => fig(i, "(min-width: 768px) 50vw, 100vw"))}
              </div>
            ) : (
              <div class="mt-14 grid gap-6 lg:grid-cols-12">
                {fig(lead, "(min-width: 1024px) 50vw, 100vw", "lg:col-span-6")}
                <div class="space-y-6 lg:col-span-6">{rest.map((i) => fig(i, "(min-width: 1024px) 50vw, 100vw"))}</div>
              </div>
            )}
          </section>
        );
      }

      if (s.type === "gallery" && items.length) return (
        <section class="gutter mx-auto mt-40 max-w-[1440px]" aria-labelledby={id}>
          <h2 id={id} class={H2}>{s.heading}</h2>
          {/* masonry: photos keep their own proportions, columns fill top to bottom */}
          <div class="mt-12"><Masonry items={items.map((i) => ({ src: i.src, alt: i.alt, caption: i.alt, meta: `${i.zone} · ${i.place}` }))} /></div>
        </section>
      );

      return null;
    })}

    <nav class="gutter mx-auto mt-24 flex max-w-[1440px] flex-wrap justify-between gap-6 border-t border-ink pt-5 text-[17px]" aria-label="Projects">
      <a href="/">Back to all work</a>
      {next.data.slug !== d.slug && <a href={`/work/${next.data.slug}/`}>Next: {next.data.title}</a>}
    </nav>
  </main>
  </div>
</Base>

<script>
  // mark the section being read in the side bar
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']")].map((a) => [a.hash.slice(1), a]));
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) links.forEach((a, id) => a.setAttribute("aria-current", String(id === e.target.id)));
  }, { rootMargin: "0px 0px -65% 0px" });
  links.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
</script>
