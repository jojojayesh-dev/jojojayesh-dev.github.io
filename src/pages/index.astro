---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Jayesh Banerjee" description="I design spaces and the images that explain them.">
  <main class="gutter mx-auto max-w-[1440px] py-10">
    <span class="kicker">Portfolio · B.Arch, Christ University</span>
    <h1 class="mt-10 font-serif text-[clamp(48px,9vw,140px)] leading-[.92] font-light tracking-[-.03em]">
      Jayesh <em class="text-laterite">Banerjee</em>
    </h1>
    <p class="mt-6 border-t border-ink pt-5 font-serif text-[clamp(20px,2vw,28px)] font-light">I design spaces and the images that explain them.</p>
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {projects.map(({ data: d }) => (
        <li>
          <a href={`/work/${d.slug}/`} class="block text-ink no-underline">
            <Image src={d.cover} alt="" widths={[640, 1280]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" loading="eager" />
            <span class="mt-3 flex justify-between gap-4"><span class="font-serif text-2xl font-light">{d.title}</span><span class="text-olive text-sm">{d.year}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
