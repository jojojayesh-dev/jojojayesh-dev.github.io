---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import WorkCard from "../components/WorkCard.astro";
import ScrollReveal from "../components/rb/ScrollReveal";
import series from "../data/photography.json";
import type { ImageMetadata } from "astro";

const photoFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/photography/*/*.jpg", { eager: true });
const ph = (f: string) => photoFiles[`../assets/photography/${f}`].default;
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const lead = projects[0]?.data;
const shots = Object.fromEntries((lead?.sections.find((s) => s.type === "gallery")?.items ?? []).map((g) => [g.src.src.split("/").pop()?.split(".")[0], g]));
// my three principles, each shown with one of my own photographs from the lead project
const principles = [
  ["Framing as restraint", "What I leave out of a frame matters as much as what I keep. Photography taught me that before architecture did.", shots["IMG_8004"]],
  ["Gathering deserves craft", "When people come together, every detail is a gesture of care. A proportion or a material can make someone feel considered.", shots["IMG_8044"]],
  ["Constraint clarifies", "A small budget, a tight site, a handful of local materials. Limits force a clear answer.", shots["IMG_7942"]],
] as const;
const year = String(lead?.year ?? new Date().getFullYear()).slice(2);
---
<Base title="Jayesh Banerjee · Architecture, photography, design" description="I design spaces and the images that explain them. Portfolio of Jayesh Banerjee, B.Arch, Christ University.">
  <main id="main" class="gutter mx-auto max-w-[1440px]">
    <section class="flex min-h-[max(50vh,22rem)] flex-col justify-center">
      <h1 class="flex flex-wrap items-baseline justify-between gap-x-8 font-display text-[clamp(56px,12.6vw,210px)] leading-[.85] font-normal tracking-[-.05em]">
        <span class="-ml-[.05em]">Portfolio</span><span><span class="text-accent">’</span>{year}</span>
      </h1>
      <p class="mt-8 max-w-[34ch] text-[clamp(18px,1.6vw,24px)] leading-snug" data-load="2">I design spaces and the images that explain them. B.Arch student at Christ University, Bengaluru.</p>
    </section>

    <section class="mt-16" aria-labelledby="selected">
      <h2 id="selected" class="text-[13px] uppercase md:text-[15px]" data-load="3">Selected works</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {projects.map(({ data: d }, i) => (
          <div data-load={String(4 + i)}>
            <WorkCard href={`/work/${d.slug}/`} title={d.title} tags={[d.course.split(",")[0], ...d.tags.slice(0, 3)]} a={d.cover} b={d.cover_hover} alt={d.cover_alt} note={d.cover_ai ? "AI-assisted renders" : undefined} eager />
          </div>
        ))}
        <div data-load={String(4 + projects.length)}>
          <WorkCard href="/photography/" title="Photography" tags={[`${series.length} series`, "Nikon D5100 / D7000", "since 2013"]} a={ph(series[0].photos[0].file)} b={ph(series[1].photos[0].file)} alt={series[0].photos[0].alt} eager />
        </div>
      </div>
    </section>

    <section class="mt-40" aria-labelledby="how">
      <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12 lg:items-end">
        <h2 id="how" class="font-display text-[clamp(48px,7vw,120px)] leading-[.9] font-normal tracking-[-.04em] lg:col-span-6">How I work</h2>
        <ScrollReveal client:visible enableBlur={false} baseOpacity={0.15} baseRotation={0} containerClassName="max-w-[30ch] lg:col-span-6" textClassName="font-display text-[clamp(26px,2.6vw,36px)] leading-snug tracking-tight">What I leave out of a frame matters as much as what I keep.</ScrollReveal>
      </div>
      <ul class="mt-12 grid gap-x-4 gap-y-14 md:grid-cols-3">
        {principles.map(([t, d, img]) => (
          <li>
            {img && <Image src={img.src} alt={img.alt} widths={[400, 640, 900]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/5] w-full object-cover" />}
            <h3 class="mt-5 font-display text-[clamp(22px,2vw,30px)] tracking-tight">{t}</h3>
            <p class="mt-2 max-w-[44ch] text-[17px]">{d}</p>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
