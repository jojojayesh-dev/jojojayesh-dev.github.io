---
import Base from "../layouts/Base.astro";
---
<Base title="Jayesh Banerjee" description="I design spaces and the images that explain them.">
  <main class="gutter mx-auto flex min-h-svh max-w-[1440px] flex-col justify-between py-10">
    <span class="kicker">Portfolio · B.Arch, Christ University</span>
    <h1 class="font-serif text-[clamp(48px,9vw,140px)] leading-[.92] font-light tracking-[-.03em]">
      Jayesh<br /><em class="text-laterite">Banerjee</em>
    </h1>
    <div class="flex flex-wrap items-end justify-between gap-6 border-t border-ink pt-5">
      <p class="font-serif text-[clamp(20px,2vw,28px)] font-light">I design spaces and the images that explain them.</p>
      <p class="text-olive text-sm">First case study, Red Earth Kindergarten, is on its way.</p>
    </div>
  </main>
</Base>
