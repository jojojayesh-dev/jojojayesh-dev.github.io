---
// My photography and drawing, in series. Pictures live in src/assets/photography, captions in src/data/photography.json.
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Masonry from "../components/Masonry.astro";
import series from "../data/photography.json";

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/photography/*/*.jpg", { eager: true });
const img = (f: string) => files[`../assets/photography/${f}`].default;
const H2 = "font-display text-[clamp(40px,5.8vw,100px)] leading-[.92] font-normal tracking-[-.04em]";
const first = img(series[0].photos[0].file);
---
<Base title="Photography · Jayesh Banerjee" description="My photography and drawing: birds and open sky, Durga Puja, black and white, a motorcycle meet, and pencil and ink work." image={first} imageAlt={series[0].photos[0].alt}>
  <main id="main" class="gutter mx-auto max-w-[1440px]">
    <section class="pt-6">
      <h1 class="font-display text-[clamp(64px,13.5vw,230px)] leading-[.86] font-normal tracking-[-.05em]">Photography<span class="text-accent">.</span></h1>
      <div class="mt-10 grid gap-x-16 gap-y-6 lg:grid-cols-12" data-load="2">
      <div class="lg:col-span-6">
        <p class="max-w-[34ch] font-display text-2xl leading-snug font-normal">Photography came before architecture. This is what I see when I am not designing.</p>
        <ol class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[17px]">
          {series.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ol>
      </div>
      </div>
    </section>

    {series.map((s) => (
      <section class="mt-32 first-of-type:mt-16" aria-labelledby={s.id}>
        <div class="grid gap-x-16 gap-y-4 border-t border-ink pt-6 lg:grid-cols-12 lg:items-end">
          <h2 id={s.id} class={`${H2} lg:col-span-7`}>{s.title}</h2>
          <p class="max-w-[44ch] text-[17px] lg:col-span-5">{s.line}</p>
        </div>
        <div class="mt-10"><Masonry items={s.photos.map((p) => ({ src: img(p.file), alt: p.alt }))} /></div>
      </section>
    ))}

    <p class="mt-24 max-w-[60ch] text-[17px]">More, as I shoot it, on <a href="https://www.instagram.com/jayesh_banerjee/" rel="me">Instagram @jayesh_banerjee</a>.</p>
  </main>
</Base>
