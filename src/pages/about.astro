---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import series from "../data/photography.json";

// my own photographs, picked from the Photography page's series by file
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/photography/*/*.jpg", { eager: true });
const photo = (file: string) => {
  const p = series.flatMap((s) => s.photos).find((x) => x.file === file)!;
  return { src: files[`../assets/photography/${file}`].default, alt: p.alt };
};
const hero = photo("outdoors/outdoors-01.jpg");
const lens = ["durga/durga-01.jpg", "monochrome/monochrome-02.jpg", "outdoors/outdoors-09.jpg"].map(photo);

// work and recognition as listed in my Portfolio 25'
const work = [
  ["The Dream Machine", "Production assistant, internship"],
  ["PawCare Foundation", "Design head, events"],
  ["Brijwasi Foundation", "Graphic design"],
];
const recognition = [
  ["Photographer of the Year", "Pentagram magazine"],
  ["2nd prize, national art and photography exhibition", "Pentagram magazine"],
  ["Photograph published in MIRAGE", "Pentagram magazine"],
  ["Special Mention for photography", "VIDMUN 2023"],
];
const disciplines = ["Architecture", "Photography", "Videography", "Graphic design", "AI-assisted image making"];
const H2 = "font-display text-[clamp(40px,5.8vw,100px)] leading-[.92] font-normal tracking-[-.04em]";
---
<Base title="About · Jayesh Banerjee" description="I'm Jayesh Banerjee, a B.Arch student at Christ University working across architecture, photography, film and design." image={hero.src} imageAlt={hero.alt}>
  <main id="main" class="gutter mx-auto max-w-[1440px]">
    <h1 class="pt-6 font-display text-[clamp(40px,10.5vw,190px)] leading-[.86] font-normal tracking-[-.05em]">Observation came first<span class="text-accent">.</span></h1>
    <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4" data-load="2">
      <a href="mailto:jojojayesh329@gmail.com" class="inline-block bg-ink px-6 py-3.5 text-paper no-underline transition-colors hover:bg-brick hover:text-paper">Email me</a>
      <a href="https://www.linkedin.com/in/jayesh-banerjee-253b062a7/" rel="me" class="text-[17px]">My LinkedIn</a>
    </div>
    <section class="mt-14 grid gap-x-16 gap-y-10 lg:grid-cols-12" data-load="3">
      <div class="lg:col-span-6">
        <figure>
          <Image src={hero.src} alt={hero.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[4/5] w-full object-cover" loading="eager" />
          <figcaption class="mt-2 text-sm text-olive">My photograph.</figcaption>
        </figure>
      </div>
      <div class="space-y-5 text-[17px] lg:col-span-5 lg:col-start-8 lg:pt-4">
        <p class="max-w-[56ch]">I was about ten when a white-throated kingfisher landed on the wire outside my window. I took my dad’s old camera and shot it. The photo worked, and I needed to know why. That question turned into a habit: every picture after it, I asked what made it work.</p>
        <p class="max-w-[56ch]">Films taught me sequence. Shelves of art supplies taught me to learn by failing. Debating taught me to think under pressure. At seventeen none of it fitted one box, until I saw that architecture holds all of it. A space is framed like a photograph, paced like a film, shaped by constraint and made with craft.</p>
        <p class="max-w-[56ch]">Now I’m studying B.Arch at Christ University School of Architecture in Bengaluru, and I still design the way I photograph: by deciding what to leave out.</p>
      </div>
    </section>

    <section class="mt-40" aria-labelledby="eye">
      <div class="grid gap-x-16 gap-y-4 lg:grid-cols-12 lg:items-end">
        <h2 id="eye" class={`${H2} lg:col-span-7`}>Through my lens</h2>
        <p class="text-[17px] lg:col-span-5"><a href="/photography/">See all my photography</a></p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-3">
        {lens.map((g, i) => (
          <figure class={i === 2 ? "col-span-2 lg:col-span-1" : ""}>
            <Image src={g.src} alt={g.alt} widths={[400, 640, 960]} sizes="(min-width: 1024px) 30vw, 50vw" class="aspect-[4/5] w-full object-cover" />
          </figure>
        ))}
      </div>
    </section>

    <section class="mt-40 grid gap-x-16 gap-y-8 lg:grid-cols-12" aria-labelledby="work">
      <h2 id="work" class={`${H2} lg:col-span-4`}>Where I’ve worked</h2>
      <dl class="lg:col-span-8">
        {work.map(([org, role]) => (
          <div class="grid gap-x-10 border-t border-ink py-5 md:grid-cols-8">
            <dt class="font-display text-2xl font-normal md:col-span-4">{org}</dt>
            <dd class="text-[17px] md:col-span-4">{role}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-40 grid gap-x-16 gap-y-8 lg:grid-cols-12" aria-labelledby="rec">
      <h2 id="rec" class={`${H2} lg:col-span-4`}>Recognition</h2>
      <dl class="lg:col-span-8">
        {recognition.map(([what, who]) => (
          <div class="grid gap-x-10 border-t border-ink py-5 md:grid-cols-8">
            <dt class="font-display text-2xl font-normal md:col-span-5">{what}</dt>
            <dd class="text-[17px] text-olive md:col-span-3">{who}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-40 grid gap-x-16 gap-y-8 bg-kraft p-[clamp(24px,4vw,64px)] lg:grid-cols-12" aria-labelledby="disc">
      <h2 id="disc" class={`${H2} lg:col-span-4`}>What I make</h2>
      <ul class="grid grid-cols-2 gap-x-10 gap-y-3 font-display text-2xl font-normal sm:grid-cols-3 lg:col-span-8">
        {disciplines.map((x) => <li>{x}</li>)}
      </ul>
    </section>
  </main>
</Base>
