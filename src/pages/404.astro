---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
// the "Absence" frame from my Auroville photographs, fitting for a page that isn't there
const lead = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order)[0]?.data;
const photo = lead?.sections.find((s) => s.type === "gallery")?.items?.find((g) => g.zone === "Absence");
---
<Base title="Not found · Jayesh Banerjee" description="This page doesn't exist.">
  <main id="main" class="gutter mx-auto grid max-w-[1440px] items-center gap-x-16 gap-y-10 pt-6 pb-24 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h1 class="font-display text-[clamp(44px,10vw,230px)] leading-[.86] font-normal tracking-[-.05em]">Not found<span class="text-accent">.</span></h1>
      <p class="mt-8 max-w-[30ch] font-display text-2xl leading-snug font-normal">Nothing here. Deliberately.</p>
      <a href="/" class="mt-8 inline-block bg-ink px-6 py-3.5 text-[17px] text-paper no-underline transition-colors hover:bg-brick">Back to my work</a>
    </div>
    {photo && (
      <figure class="lg:col-span-6 lg:col-start-7">
        <Image src={photo.src} alt={photo.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[4/5] w-full object-cover" loading="eager" />
        <figcaption class="mt-2 text-sm text-olive">{photo.place}, June 2026.</figcaption>
      </figure>
    )}
  </main>
</Base>
